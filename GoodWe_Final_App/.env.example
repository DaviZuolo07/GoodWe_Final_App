# Copie para .env (o .env está no .gitignore e NUNCA vai para o repositório).
#     cp .env.example .env

# --- Provedor principal: Ollama Cloud -----------------------------------------
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=cole_a_chave_aqui          # https://ollama.com/settings/keys

# --- Modelos do experimento (bloco B: 2+ modelos) -----------------------------
OLLAMA_MODEL=gpt-oss:120b                 # principal
OLLAMA_MODEL_B=gemma4:31b                 # comparação
OLLAMA_MODEL_C=gpt-oss:20b                # extra (opcional)
# Prefixo "local:" usa o Ollama da máquina (2º provedor, bônus multi-provider):
# OLLAMA_MODEL_C=local:qwen3:8b
OLLAMA_HOST_LOCAL=http://127.0.0.1:11434

# Raciocínio dos modelos gpt-oss/qwen3: low | medium | high | none
OLLAMA_THINK=low

# --- Juiz do eval (fora da lista de modelos avaliados) ------------------------
MODELO_JUIZ=glm-5.3-flash

# --- Chatbot ------------------------------------------------------------------
PROMPT_VERSAO=v2
MEMORIA_MAX_TOKENS=1200
EXTRACAO_FORMATO=compacto                 # compacto | pydantic
